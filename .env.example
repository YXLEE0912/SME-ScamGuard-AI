# Platform Configuration
RISK_THRESHOLD=50.0
ENVIRONMENT=development

# Google Gemini API Key (Optional for offline demo mode with heuristic fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth 2.0 Credentials (for Live Mailbox Integration)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Inbound Email IMAP Connector (Optional)
GMAIL_USER=accounting@yourcompany.com.my
GMAIL_APP_PASSWORD=your_app_password
