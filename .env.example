# Platform Configuration
RISK_THRESHOLD=50.0
ENVIRONMENT=development

# Google Gemini API Key (Optional for offline demo mode with heuristic fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Out-of-Band Telegram SecOps Alerts (Optional: dummy values activate safe local logging)
TELEGRAM_BOT_TOKEN=dummy_token_for_dev
TELEGRAM_CHAT_ID=dummy_chat_id

# Inbound Email IMAP Connector (Optional)
GMAIL_USER=accounting@yourcompany.com.my
GMAIL_APP_PASSWORD=your_app_password
